# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima

# Somente servidor. Nunca exponha este valor no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Asaas Sandbox (Etapa 6B). Somente servidor. Nunca use chaves de produção.
# O código rejeita qualquer endpoint que não seja api-sandbox.asaas.com/v3.
ASAAS_ENVIRONMENT=sandbox
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token forte (32 a 255 caracteres) enviado pelo Asaas no header
# asaas-access-token. Gere um valor próprio e cadastre-o no painel Sandbox.
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=AVDelivery/1.0
ASAAS_TIMEOUT_MS=15000

# Processador e conciliação fora do ciclo HTTP (Etapa 7A).
# Segredo exigido pelas rotas /api/internal/billing/*. 32 a 255 caracteres.
# BILLING_WORKER_SECRET tem precedência; CRON_SECRET serve de fallback.
BILLING_WORKER_SECRET=
CRON_SECRET=
BILLING_WORKER_BATCH_SIZE=10
BILLING_WORKER_MAX_EVENTS=25
BILLING_WORKER_LEASE_SECONDS=120
BILLING_WORKER_MAX_ATTEMPTS=8
BILLING_WORKER_TIME_BUDGET_MS=45000
BILLING_RECONCILE_LIMIT=25
BILLING_RECONCILE_MAX_PAYMENTS=100
BILLING_RECONCILE_TIME_BUDGET_MS=45000

# Origem pública usada nos links de autenticação (sem barra no final).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# scripts/bootstrap-superadmin.mjs
SUPERADMIN_EMAIL=admin@exemplo.com
SUPERADMIN_NAME=Administrador da plataforma
# Obrigatória apenas se o usuário ainda não existir (mínimo de 12 caracteres).
SUPERADMIN_PASSWORD=

# scripts/seed-demo.mjs
DEMO_STORE_NAME=Burger Demo
DEMO_STORE_SLUG=burger-demo
DEMO_STORE_DESCRIPTION=Hamburgueria de demonstração criada pelo script de seed.
DEMO_STORE_PHONE=(11) 90000-0000
DEMO_OWNER_EMAIL=dono@exemplo.com
DEMO_OWNER_NAME=Dono da Loja Demo
# Obrigatória apenas se o proprietário ainda não existir (mínimo de 12 caracteres).
DEMO_OWNER_PASSWORD=

# Testes de integração contra um projeto Supabase LOCAL/DE TESTE.
# Deixe vazio para ignorar os testes de RLS. Nunca aponte para produção.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
